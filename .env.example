# ClipStory release credentials — copy to .env and fill in ONE of the three routes.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it. Never paste its contents into a chat,
# an issue, or a PR.
#
# Routes are listed best-first. The script auto-detects which one you filled in
# and prefers them in this order: KEYCHAIN > API KEY > APPLE ID.
#
# Forgejo and GitHub uploads use your existing `tea` and `gh` logins, so no
# tokens are needed here.

# ---------------------------------------------------------------------------
# ROUTE 1 — Keychain profile  (recommended: no secret in this file at all)
# ---------------------------------------------------------------------------
# One-time setup, run it yourself so the password goes straight to the Keychain:
#
#   xcrun notarytool store-credentials ClipStory \
#     --apple-id brian@example.com \
#     --team-id D9CX25ADWQ
#
# It prompts for an app-specific password (appleid.apple.com > Sign-In and
# Security > App-Specific Passwords). Then set only this:

AC_KEYCHAIN_PROFILE=ClipStory

# ---------------------------------------------------------------------------
# ROUTE 2 — App Store Connect API key  (good: secret stays in the .p8 file)
# ---------------------------------------------------------------------------
# Create at appstoreconnect.apple.com > Users and Access > Integrations > Keys.
# Role "Developer" is enough for notarisation. You can download the .p8 ONCE.
# Store it at ~/.appstoreconnect/private_keys/ and chmod 600 it.
#
# These three values are identifiers, not secrets — the private key stays in
# the file that AC_API_KEY_PATH points at.

#AC_API_KEY_PATH=/Users/bschmalz/.appstoreconnect/private_keys/AuthKey_ABC123XYZ9.p8
#AC_API_KEY_ID=ABC123XYZ9
#AC_API_ISSUER_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# ROUTE 3 — Apple ID + app-specific password  (works, but plaintext secret)
# ---------------------------------------------------------------------------
# Only use this if the two above are impractical. AC_APP_PASSWORD is a live
# credential in cleartext on disk. Format is xxxx-xxxx-xxxx-xxxx.

#AC_APPLE_ID=brian@example.com
#AC_APP_PASSWORD=abcd-efgh-ijkl-mnop
#AC_TEAM_ID=D9CX25ADWQ

# ---------------------------------------------------------------------------
# Repositories to publish to (defaults shown)
# ---------------------------------------------------------------------------
FORGEJO_API=http://10.8.72.16/api/v1
FORGEJO_REPO=bschmalz/ClipStory
GITHUB_REPO=bschmalz81401/ClipStory
